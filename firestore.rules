rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita das coleções do sistema ARTEX7 (Estoque, Clientes, Pedidos, Empresa, Catálogo e Movimentações)
    // sincronizados diretamente entre Computador, Celular e Vercel na nuvem
    match /stock/{itemId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /catalog/{productId} {
      allow read, write: if true;
    }
    match /stock_movements/{movId} {
      allow read, write: if true;
    }
    match /system_meta/{metaId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
