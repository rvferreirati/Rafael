{
  "entities": {
    "StockItem": {
      "title": "StockItem",
      "description": "Item no controle de estoque da ARTEX7 com sincronização em nuvem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "barcode": { "type": "string" },
        "name": { "type": "string" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "costPrice": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "retailPrice": { "type": "number" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "currentStock"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Histórico de entradas, baixas e estornos de estoque",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "stockItemId": { "type": "string" },
        "itemCode": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "stockItemId", "quantity", "timestamp"]
    },
    "SalesOrder": {
      "title": "SalesOrder",
      "description": "Pedido de venda gerado no sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "orderDate": { "type": "string" },
        "orderDueDate": { "type": "string" },
        "status": { "type": "string" },
        "subtotal": { "type": "number" },
        "discountRate": { "type": "number" },
        "discountAmount": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "orderNumber"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Cliente cadastrado na ARTEX7 sincronizado em todos os dispositivos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "CompanyProfile": {
      "title": "CompanyProfile",
      "description": "Dados da empresa emissora para cabeçalho e PDFs",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "currency": { "type": "string" },
        "defaultTaxRate": { "type": "number" },
        "logoUrl": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "taxId"]
    },
    "CatalogProduct": {
      "title": "CatalogProduct",
      "description": "Produto no catálogo geral da ARTEX7",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/stock/{itemId}": {
      "schema": "StockItem",
      "description": "Coleção de estoque sincronizada entre PC e Celular em tempo real"
    },
    "/stock_movements/{movId}": {
      "schema": "StockMovement",
      "description": "Movimentações de entrada e saída do estoque sincronizadas"
    },
    "/orders/{orderId}": {
      "schema": "SalesOrder",
      "description": "Coleção de pedidos de venda (Histórico) sincronizada em tempo real"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Coleção de clientes sincronizada entre PC e Celular"
    },
    "/settings/{settingId}": {
      "schema": "CompanyProfile",
      "description": "Configurações globais da empresa emissora (company_profile)"
    },
    "/catalog/{productId}": {
      "schema": "CatalogProduct",
      "description": "Catálogo mestre de produtos sincronizado"
    }
  }
}
