<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SalesOrder Pro - OCR & Order Management</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tesseract.js (Client-side OCR) -->
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <!-- jsPDF & AutoTable -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
  
  <style>
    .tab-active {
      border-bottom: 2px solid #4f46e5;
      color: #4f46e5;
      font-weight: 600;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

  <!-- Top Navigation Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between h-16 items-center">
      <div class="flex items-center space-x-3">
        <div class="bg-indigo-600 text-white p-2 rounded-lg font-bold text-lg leading-none">SO</div>
        <span class="text-xl font-bold tracking-tight text-slate-900">SalesOrder<span class="text-indigo-600">Pro</span></span>
      </div>
      <nav class="flex space-x-6 text-sm">
        <button onclick="switchTab('create-order')" id="tab-create-order" class="py-5 px-1 tab-active transition-all">New Order & OCR</button>
        <button onclick="switchTab('customers')" id="tab-customers" class="py-5 px-1 text-slate-500 hover:text-slate-800 transition-all">Customers</button>
        <button onclick="switchTab('history')" id="tab-history" class="py-5 px-1 text-slate-500 hover:text-slate-800 transition-all">Order History</button>
        <button onclick="switchTab('settings')" id="tab-settings" class="py-5 px-1 text-slate-500 hover:text-slate-800 transition-all">Company Profile</button>
      </nav>
    </div>
  </header>

  <!-- Main Content Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">

    <!-- ========================================== -->
    <!-- TAB 1: NEW SALES ORDER & OCR PROCESSOR     -->
    <!-- ========================================== -->
    <section id="section-create-order" class="space-y-6">
      
      <!-- OCR Upload Area -->
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-semibold text-slate-900">Import Screenshot or Image</h2>
            <p class="text-sm text-slate-500">Upload a screenshot of an invoice, po, or quote to automatically extract items.</p>
          </div>
          <span class="text-xs bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full font-medium">OCR Enabled</span>
        </div>

        <div id="dropZone" class="border-2 border-dashed border-slate-300 rounded-lg p-6 text-center cursor-pointer hover:border-indigo-500 hover:bg-indigo-50/20 transition-all">
          <input type="file" id="imageInput" accept="image/*" class="hidden" />
          <svg class="mx-auto h-10 w-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <p class="mt-2 text-sm text-slate-600 font-medium">Click to upload or drag & drop a screenshot</p>
          <p class="text-xs text-slate-400 mt-1">PNG, JPG, WebP supported</p>
        </div>

        <!-- OCR Processing Bar -->
        <div id="ocrProgress" class="hidden mt-4 space-y-2">
          <div class="flex justify-between text-xs font-semibold text-slate-600">
            <span id="ocrStatusText">Recognizing text...</span>
            <span id="ocrPercent">0%</span>
          </div>
          <div class="w-full bg-slate-100 rounded-full h-2">
            <div id="ocrBar" class="bg-indigo-600 h-2 rounded-full transition-all" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <!-- Sales Order Editable Form -->
      <form id="orderForm" onsubmit="event.preventDefault(); saveAndGeneratePDF();" class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-6">
        <div class="flex justify-between items-center border-b border-slate-100 pb-4">
          <h2 class="text-lg font-bold text-slate-900">Sales Order Details</h2>
          <div class="flex space-x-2">
            <button type="button" onclick="resetOrderForm()" class="px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 rounded-md border border-slate-200">Clear Form</button>
          </div>
        </div>

        <!-- Top Order Info Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Order Number *</label>
            <input type="text" id="orderNumber" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Order Date *</label>
            <input type="date" id="orderDate" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Expected Delivery Date</label>
            <input type="date" id="orderDueDate" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
          </div>
        </div>

        <!-- Customer Selection Grid -->
        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-4">
          <div class="flex items-center justify-between">
            <label class="text-sm font-semibold text-slate-800">Customer Information</label>
            <button type="button" onclick="switchTab('customers')" class="text-xs text-indigo-600 hover:underline">+ New Customer</button>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs text-slate-500 mb-1">Select Registered Customer</label>
              <select id="customerSelect" onchange="applySelectedCustomer()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                <option value="">-- Choose a Customer or Enter Manually --</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-slate-500 mb-1">Customer / Company Name *</label>
              <input type="text" id="custName" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white" />
            </div>
            <div>
              <label class="block text-xs text-slate-500 mb-1">Tax ID / VAT / GST</label>
              <input type="text" id="custTaxId" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white" />
            </div>
            <div>
              <label class="block text-xs text-slate-500 mb-1">Email Address</label>
              <input type="email" id="custEmail" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white" />
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs text-slate-500 mb-1">Billing / Shipping Address</label>
              <textarea id="custAddress" rows="2" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white"></textarea>
            </div>
          </div>
        </div>

        <!-- Order Line Items -->
        <div>
          <div class="flex justify-between items-center mb-2">
            <h3 class="text-sm font-semibold text-slate-800">Items & Products</h3>
            <button type="button" onclick="addLineItem()" class="text-xs bg-indigo-50 text-indigo-600 px-3 py-1.5 rounded font-medium hover:bg-indigo-100">+ Add Line Item</button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse" id="itemsTable">
              <thead>
                <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-50">
                  <th class="py-2 px-3">Item Code</th>
                  <th class="py-2 px-3 w-1/3">Description</th>
                  <th class="py-2 px-3 w-20 text-right">Qty</th>
                  <th class="py-2 px-3 w-28 text-right">Unit Price ($)</th>
                  <th class="py-2 px-3 w-28 text-right">Total ($)</th>
                  <th class="py-2 px-2 text-center w-12">Action</th>
                </tr>
              </thead>
              <tbody id="lineItemsBody" class="divide-y divide-slate-100">
                <!-- Dynamic Items -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Calculations & Totals -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Order Notes & Payment Terms</label>
            <textarea id="orderNotes" rows="4" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="e.g. Payment due within 30 days via Wire Transfer."></textarea>
          </div>

          <div class="space-y-3 bg-slate-50 p-4 rounded-lg border border-slate-200">
            <div class="flex justify-between text-sm">
              <span class="text-slate-600">Subtotal:</span>
              <span id="valSubtotal" class="font-medium text-slate-900">$0.00</span>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="text-slate-600">Discount (%):</span>
              <input type="number" id="discountRate" value="0" min="0" max="100" step="0.5" oninput="calculateTotals()" class="w-20 border border-slate-300 rounded px-2 py-1 text-right text-sm bg-white" />
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="text-slate-600">Tax / VAT (%):</span>
              <input type="number" id="taxRate" value="8" min="0" max="100" step="0.5" oninput="calculateTotals()" class="w-20 border border-slate-300 rounded px-2 py-1 text-right text-sm bg-white" />
            </div>
            <div class="flex justify-between text-base font-bold text-slate-900 border-t border-slate-200 pt-2">
              <span>Grand Total:</span>
              <span id="valGrandTotal" class="text-indigo-600">$0.00</span>
            </div>
          </div>
        </div>

        <!-- Submit & Generate Action -->
        <div class="flex justify-end pt-4">
          <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-lg shadow-sm flex items-center space-x-2 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span>Save & Generate PDF</span>
          </button>
        </div>
      </form>
    </section>

    <!-- ========================================== -->
    <!-- TAB 2: CUSTOMER MANAGEMENT                 -->
    <!-- ========================================== -->
    <section id="section-customers" class="hidden space-y-6">
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Customer Directory</h2>
          <p class="text-sm text-slate-500">Manage your business clients and accounts.</p>
        </div>
        <button onclick="openCustomerModal()" class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700">+ Add Customer</button>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase">
            <tr>
              <th class="py-3 px-4">Name / Company</th>
              <th class="py-3 px-4">Tax ID</th>
              <th class="py-3 px-4">Email</th>
              <th class="py-3 px-4">Phone</th>
              <th class="py-3 px-4">Address</th>
              <th class="py-3 px-4 text-center">Actions</th>
            </tr>
          </thead>
          <tbody id="customersTableBody" class="divide-y divide-slate-100">
            <!-- Rendered dynamically -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- TAB 3: ORDER HISTORY                       -->
    <!-- ========================================== -->
    <section id="section-history" class="hidden space-y-6">
      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Order History</h2>
          <p class="text-sm text-slate-500">View past sales orders and regenerate PDFs anytime.</p>
        </div>
        <input type="text" id="orderSearch" oninput="renderOrdersHistory()" placeholder="Search order or customer..." class="border border-slate-300 rounded-lg px-3 py-1.5 text-sm w-64 focus:ring-2 focus:ring-indigo-500 outline-none" />
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase">
            <tr>
              <th class="py-3 px-4">Order #</th>
              <th class="py-3 px-4">Date</th>
              <th class="py-3 px-4">Customer</th>
              <th class="py-3 px-4 text-right">Items</th>
              <th class="py-3 px-4 text-right">Total Amount</th>
              <th class="py-3 px-4 text-center">Actions</th>
            </tr>
          </thead>
          <tbody id="ordersTableBody" class="divide-y divide-slate-100">
            <!-- Rendered dynamically -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- TAB 4: COMPANY PROFILE / SETTINGS          -->
    <!-- ========================================== -->
    <section id="section-settings" class="hidden space-y-6">
      <div class="max-w-2xl bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
        <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">Company Header Settings</h2>
        <p class="text-xs text-slate-500">This information appears at the top of all generated Sales Order PDFs.</p>
        
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Company Name</label>
          <input type="text" id="cfgCompanyName" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Tax ID / Business Number</label>
          <input type="text" id="cfgCompanyTaxId" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Contact Email</label>
          <input type="email" id="cfgCompanyEmail" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Phone</label>
          <input type="text" id="cfgCompanyPhone" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Address</label>
          <textarea id="cfgCompanyAddress" rows="3" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>
        </div>

        <button onclick="saveCompanyProfile()" class="bg-indigo-600 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700">Save Company Info</button>
      </div>
    </section>

  </main>

  <!-- Customer Modal (Add/Edit) -->
  <div id="customerModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 space-y-4">
      <div class="flex justify-between items-center border-b border-slate-100 pb-3">
        <h3 id="modalCustomerTitle" class="text-base font-bold text-slate-900">Add Customer</h3>
        <button onclick="closeCustomerModal()" class="text-slate-400 hover:text-slate-600">&times;</button>
      </div>
      <form id="customerForm" onsubmit="event.preventDefault(); saveCustomer();" class="space-y-3">
        <input type="hidden" id="custModalId" />
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Customer / Company Name *</label>
          <input type="text" id="custModalName" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Tax ID / VAT</label>
          <input type="text" id="custModalTaxId" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Email</label>
          <input type="email" id="custModalEmail" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Phone</label>
          <input type="text" id="custModalPhone" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Address</label>
          <textarea id="custModalAddress" rows="2" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none"></textarea>
        </div>
        <div class="flex justify-end space-x-2 pt-2">
          <button type="button" onclick="closeCustomerModal()" class="px-4 py-2 border border-slate-200 text-sm rounded-lg hover:bg-slate-50">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700">Save Customer</button>
        </div>
      </form>
    </div>
  </div>

  <!-- JavaScript Application Logic -->
  <script>
    // --- Initial Seed / Storage Handling ---
    const STORAGE_KEYS = {
      CUSTOMERS: 'so_customers_data',
      ORDERS: 'so_orders_data',
      COMPANY: 'so_company_profile'
    };

    let customers = JSON.parse(localStorage.getItem(STORAGE_KEYS.CUSTOMERS)) || [
      { id: '1', name: 'Global Logistics Ltd', taxId: 'US-8839210', email: 'billing@globallogistics.com', phone: '+1 555-0144', address: '445 Industrial Parkway, Chicago, IL' },
      { id: '2', name: 'Quantum Cloud Inc', taxId: 'EU-9920194', email: 'accounts@quantumcloud.io', phone: '+1 555-0199', address: '78 Silicon Alley, Austin, TX' }
    ];

    let orders = JSON.parse(localStorage.getItem(STORAGE_KEYS.ORDERS)) || [];

    let companyProfile = JSON.parse(localStorage.getItem(STORAGE_KEYS.COMPANY)) || {
      name: 'Apex Industrial Solutions Inc.',
      taxId: 'US-981240-X',
      email: 'orders@apexindustrial.com',
      phone: '+1 (800) 555-9000',
      address: '100 Innovation Blvd, Suite 500, Boston, MA 02110'
    };

    function persist(key, data) {
      localStorage.setItem(key, JSON.stringify(data));
    }

    // --- Navigation Tabs ---
    function switchTab(tabId) {
      ['create-order', 'customers', 'history', 'settings'].forEach(id => {
        document.getElementById(`section-${id}`).classList.add('hidden');
        document.getElementById(`tab-${id}`).classList.remove('tab-active');
        document.getElementById(`tab-${id}`).classList.add('text-slate-500');
      });
      document.getElementById(`section-${tabId}`).classList.remove('hidden');
      document.getElementById(`tab-${tabId}`).classList.add('tab-active');
      document.getElementById(`tab-${tabId}`).classList.remove('text-slate-500');

      if (tabId === 'customers') renderCustomersTable();
      if (tabId === 'history') renderOrdersHistory();
      if (tabId === 'create-order') populateCustomerSelect();
    }

    // --- Drop Zone & OCR Processing ---
    const dropZone = document.getElementById('dropZone');
    const imageInput = document.getElementById('imageInput');

    dropZone.addEventListener('click', () => imageInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-indigo-500', 'bg-indigo-50/20'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-indigo-500', 'bg-indigo-50/20'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-indigo-500', 'bg-indigo-50/20');
      if (e.dataTransfer.files.length) handleImageFile(e.dataTransfer.files[0]);
    });
    imageInput.addEventListener('change', (e) => {
      if (e.target.files.length) handleImageFile(e.target.files[0]);
    });

    async function handleImageFile(file) {
      if (!file.type.startsWith('image/')) {
        alert('Please select a valid image file.');
        return;
      }

      const ocrProgress = document.getElementById('ocrProgress');
      const ocrStatusText = document.getElementById('ocrStatusText');
      const ocrPercent = document.getElementById('ocrPercent');
      const ocrBar = document.getElementById('ocrBar');

      ocrProgress.classList.remove('hidden');
      ocrBar.style.width = '0%';
      ocrPercent.innerText = '0%';
      ocrStatusText.innerText = 'Initializing OCR engine...';

      try {
        const worker = await Tesseract.createWorker('eng');
        const ret = await worker.recognize(file, {}, {
          logger: m => {
            if (m.status === 'recognizing text') {
              const p = Math.round(m.progress * 100);
              ocrBar.style.width = `${p}%`;
              ocrPercent.innerText = `${p}%`;
              ocrStatusText.innerText = 'Reading text & extracting line items...';
            }
          }
        });

        await worker.terminate();
        ocrProgress.classList.add('hidden');
        parseAndPopulateOCRData(ret.data.text);
      } catch (err) {
        console.error(err);
        alert('OCR Processing failed. Please enter the details manually.');
        ocrProgress.classList.add('hidden');
      }
    }

    // Heuristic Parser for OCR Output
    function parseAndPopulateOCRData(rawText) {
      const lines = rawText.split('\n').map(l => l.trim()).filter(l => l.length > 0);

      // 1. Detect Order #
      const orderMatch = rawText.match(/(?:order|so|invoice|po)[\s#:]*([a-z0-9\-]+)/i);
      if (orderMatch && orderMatch[1]) {
        document.getElementById('orderNumber').value = orderMatch[1].toUpperCase();
      }

      // 2. Clear existing line items
      document.getElementById('lineItemsBody').innerHTML = '';

      // 3. Line Items Detection: Look for lines with quantities and decimal prices
      const detectedItems = [];
      const itemPattern = /(.*?)(?:\s+(\d+))\s+[\$€£]?([0-9]+[.,][0-9]{2})/i;

      lines.forEach((line) => {
        const match = line.match(itemPattern);
        if (match) {
          const desc = match[1].replace(/^[^a-zA-Z0-9]+/, '').trim();
          const qty = parseInt(match[2], 10);
          const price = parseFloat(match[3].replace(',', '.'));

          if (desc.length > 2 && qty > 0 && price >= 0) {
            detectedItems.push({ code: `SKU-${Math.floor(1000 + Math.random() * 9000)}`, desc, qty, price });
          }
        }
      });

      if (detectedItems.length > 0) {
        detectedItems.forEach(item => addLineItem(item.code, item.desc, item.qty, item.price));
      } else {
        // Fallback default row
        addLineItem('', 'Extracted Item (verify)', 1, 0.00);
      }

      calculateTotals();
      alert(`OCR complete! Extracted ${detectedItems.length} line items for review.`);
    }

    // --- Dynamic Line Items Manager ---
    function addLineItem(code = '', desc = '', qty = 1, price = 0) {
      const tbody = document.getElementById('lineItemsBody');
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-50 transition-colors';
      tr.innerHTML = `
        <td class="py-2 px-3"><input type="text" value="${code}" placeholder="SKU-..." class="item-code w-full border border-slate-200 rounded px-2 py-1 text-xs outline-none focus:border-indigo-500" /></td>
        <td class="py-2 px-3"><input type="text" value="${desc}" placeholder="Item description" required class="item-desc w-full border border-slate-200 rounded px-2 py-1 text-xs outline-none focus:border-indigo-500" /></td>
        <td class="py-2 px-3"><input type="number" value="${qty}" min="1" step="1" oninput="calculateTotals()" required class="item-qty w-full border border-slate-200 rounded px-2 py-1 text-xs text-right outline-none focus:border-indigo-500" /></td>
        <td class="py-2 px-3"><input type="number" value="${parseFloat(price).toFixed(2)}" min="0" step="0.01" oninput="calculateTotals()" required class="item-price w-full border border-slate-200 rounded px-2 py-1 text-xs text-right outline-none focus:border-indigo-500" /></td>
        <td class="py-2 px-3 text-right font-medium text-xs item-total">$0.00</td>
        <td class="py-2 px-2 text-center">
          <button type="button" onclick="this.closest('tr').remove(); calculateTotals();" class="text-rose-500 hover:text-rose-700 text-sm font-bold">&times;</button>
        </td>
      `;
      tbody.appendChild(tr);
      calculateTotals();
    }

    function calculateTotals() {
      const rows = document.querySelectorAll('#lineItemsBody tr');
      let subtotal = 0;

      rows.forEach(row => {
        const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
        const price = parseFloat(row.querySelector('.item-price').value) || 0;
        const lineTotal = qty * price;
        row.querySelector('.item-total').textContent = `$${lineTotal.toFixed(2)}`;
        subtotal += lineTotal;
      });

      const discountRate = parseFloat(document.getElementById('discountRate').value) || 0;
      const taxRate = parseFloat(document.getElementById('taxRate').value) || 0;

      const discountAmount = subtotal * (discountRate / 100);
      const taxableAmount = subtotal - discountAmount;
      const taxAmount = taxableAmount * (taxRate / 100);
      const grandTotal = taxableAmount + taxAmount;

      document.getElementById('valSubtotal').textContent = `$${subtotal.toFixed(2)}`;
      document.getElementById('valGrandTotal').textContent = `$${grandTotal.toFixed(2)}`;
    }

    function resetOrderForm() {
      document.getElementById('orderNumber').value = `SO-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;
      document.getElementById('orderDate').value = new Date().toISOString().split('T')[0];
      document.getElementById('orderDueDate').value = '';
      document.getElementById('customerSelect').value = '';
      document.getElementById('custName').value = '';
      document.getElementById('custTaxId').value = '';
      document.getElementById('custEmail').value = '';
      document.getElementById('custAddress').value = '';
      document.getElementById('lineItemsBody').innerHTML = '';
      addLineItem('SKU-1001', 'Standard Product / Consulting Service', 1, 100.00);
      calculateTotals();
    }

    // --- Customer Linking Logic ---
    function populateCustomerSelect() {
      const sel = document.getElementById('customerSelect');
      sel.innerHTML = '<option value="">-- Choose a Customer or Enter Manually --</option>';
      customers.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = `${c.name} (${c.email || c.taxId || 'No ID'})`;
        sel.appendChild(opt);
      });
    }

    function applySelectedCustomer() {
      const id = document.getElementById('customerSelect').value;
      const cust = customers.find(c => c.id === id);
      if (cust) {
        document.getElementById('custName').value = cust.name;
        document.getElementById('custTaxId').value = cust.taxId || '';
        document.getElementById('custEmail').value = cust.email || '';
        document.getElementById('custAddress').value = cust.address || '';
      }
    }

    // --- Customer Directory Management ---
    function renderCustomersTable() {
      const tbody = document.getElementById('customersTableBody');
      tbody.innerHTML = '';
      customers.forEach(c => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50';
        tr.innerHTML = `
          <td class="py-3 px-4 font-medium text-slate-900">${c.name}</td>
          <td class="py-3 px-4 text-slate-500">${c.taxId || '—'}</td>
          <td class="py-3 px-4 text-slate-500">${c.email || '—'}</td>
          <td class="py-3 px-4 text-slate-500">${c.phone || '—'}</td>
          <td class="py-3 px-4 text-slate-500 truncate max-w-xs">${c.address || '—'}</td>
          <td class="py-3 px-4 text-center space-x-2">
            <button onclick="editCustomer('${c.id}')" class="text-indigo-600 hover:underline text-xs">Edit</button>
            <button onclick="deleteCustomer('${c.id}')" class="text-rose-600 hover:underline text-xs">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function openCustomerModal(id = null) {
      document.getElementById('customerModal').classList.remove('hidden');
      document.getElementById('customerModal').classList.add('flex');
      if (id) {
        const c = customers.find(x => x.id === id);
        document.getElementById('modalCustomerTitle').innerText = 'Edit Customer';
        document.getElementById('custModalId').value = c.id;
        document.getElementById('custModalName').value = c.name;
        document.getElementById('custModalTaxId').value = c.taxId || '';
        document.getElementById('custModalEmail').value = c.email || '';
        document.getElementById('custModalPhone').value = c.phone || '';
        document.getElementById('custModalAddress').value = c.address || '';
      } else {
        document.getElementById('modalCustomerTitle').innerText = 'Add Customer';
        document.getElementById('customerForm').reset();
        document.getElementById('custModalId').value = '';
      }
    }

    function closeCustomerModal() {
      document.getElementById('customerModal').classList.add('hidden');
      document.getElementById('customerModal').classList.remove('flex');
    }

    function saveCustomer() {
      const id = document.getElementById('custModalId').value;
      const newCust = {
        id: id || Date.now().toString(),
        name: document.getElementById('custModalName').value,
        taxId: document.getElementById('custModalTaxId').value,
        email: document.getElementById('custModalEmail').value,
        phone: document.getElementById('custModalPhone').value,
        address: document.getElementById('custModalAddress').value,
      };

      if (id) {
        const index = customers.findIndex(x => x.id === id);
        customers[index] = newCust;
      } else {
        customers.push(newCust);
      }

      persist(STORAGE_KEYS.CUSTOMERS, customers);
      closeCustomerModal();
      renderCustomersTable();
      populateCustomerSelect();
    }

    function deleteCustomer(id) {
      if (confirm('Are you sure you want to delete this customer?')) {
        customers = customers.filter(c => c.id !== id);
        persist(STORAGE_KEYS.CUSTOMERS, customers);
        renderCustomersTable();
        populateCustomerSelect();
      }
    }

    function editCustomer(id) {
      openCustomerModal(id);
    }

    // --- Order History Management ---
    function renderOrdersHistory() {
      const tbody = document.getElementById('ordersTableBody');
      const query = (document.getElementById('orderSearch')?.value || '').toLowerCase();
      tbody.innerHTML = '';

      const filtered = orders.filter(o => 
        o.orderNumber.toLowerCase().includes(query) || 
        o.customer.name.toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-4 text-center text-slate-400">No orders found.</td></tr>`;
        return;
      }

      filtered.forEach(o => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50';
        tr.innerHTML = `
          <td class="py-3 px-4 font-semibold text-indigo-600">${o.orderNumber}</td>
          <td class="py-3 px-4 text-slate-600">${o.orderDate}</td>
          <td class="py-3 px-4 text-slate-900 font-medium">${o.customer.name}</td>
          <td class="py-3 px-4 text-right text-slate-600">${o.items.length}</td>
          <td class="py-3 px-4 text-right font-semibold text-slate-900">$${o.grandTotal.toFixed(2)}</td>
          <td class="py-3 px-4 text-center space-x-2">
            <button onclick="downloadExistingOrderPDF('${o.id}')" class="text-xs bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded hover:bg-indigo-100">PDF</button>
            <button onclick="deleteOrder('${o.id}')" class="text-xs text-rose-500 hover:underline">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function deleteOrder(id) {
      if (confirm('Delete this order record?')) {
        orders = orders.filter(o => o.id !== id);
        persist(STORAGE_KEYS.ORDERS, orders);
        renderOrdersHistory();
      }
    }

    // --- Company Profile Settings ---
    function loadCompanyProfile() {
      document.getElementById('cfgCompanyName').value = companyProfile.name;
      document.getElementById('cfgCompanyTaxId').value = companyProfile.taxId;
      document.getElementById('cfgCompanyEmail').value = companyProfile.email;
      document.getElementById('cfgCompanyPhone').value = companyProfile.phone;
      document.getElementById('cfgCompanyAddress').value = companyProfile.address;
    }

    function saveCompanyProfile() {
      companyProfile = {
        name: document.getElementById('cfgCompanyName').value,
        taxId: document.getElementById('cfgCompanyTaxId').value,
        email: document.getElementById('cfgCompanyEmail').value,
        phone: document.getElementById('cfgCompanyPhone').value,
        address: document.getElementById('cfgCompanyAddress').value,
      };
      persist(STORAGE_KEYS.COMPANY, companyProfile);
      alert('Company profile updated successfully.');
    }

    // --- PDF Generation & Order Saving ---
    function saveAndGeneratePDF() {
      const orderNumber = document.getElementById('orderNumber').value;
      const orderDate = document.getElementById('orderDate').value;
      const orderDueDate = document.getElementById('orderDueDate').value;
      const notes = document.getElementById('orderNotes').value;

      const customer = {
        name: document.getElementById('custName').value,
        taxId: document.getElementById('custTaxId').value,
        email: document.getElementById('custEmail').value,
        address: document.getElementById('custAddress').value
      };

      const rows = document.querySelectorAll('#lineItemsBody tr');
      const items = [];
      let subtotal = 0;

      rows.forEach(r => {
        const code = r.querySelector('.item-code').value;
        const description = r.querySelector('.item-desc').value;
        const quantity = parseFloat(r.querySelector('.item-qty').value) || 0;
        const unitPrice = parseFloat(r.querySelector('.item-price').value) || 0;
        const total = quantity * unitPrice;
        subtotal += total;
        items.push({ code, description, quantity, unitPrice, total });
      });

      const discountRate = parseFloat(document.getElementById('discountRate').value) || 0;
      const taxRate = parseFloat(document.getElementById('taxRate').value) || 0;
      const discountAmount = subtotal * (discountRate / 100);
      const taxableAmount = subtotal - discountAmount;
      const taxAmount = taxableAmount * (taxRate / 100);
      const grandTotal = taxableAmount + taxAmount;

      const orderData = {
        id: Date.now().toString(),
        orderNumber,
        orderDate,
        orderDueDate,
        notes,
        customer,
        items,
        subtotal,
        discountRate,
        discountAmount,
        taxRate,
        taxAmount,
        grandTotal
      };

      // Save order to history
      orders.unshift(orderData);
      persist(STORAGE_KEYS.ORDERS, orders);

      // Generate PDF
      buildPDF(orderData);
    }

    function downloadExistingOrderPDF(orderId) {
      const orderData = orders.find(o => o.id === orderId);
      if (orderData) buildPDF(orderData);
    }

    function buildPDF(order) {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation: 'p', unit: 'mm', format: 'a4' });

      // Corporate Blue Accent
      const brandColor = [79, 70, 229];

      // --- Header: Company Info & Document Title ---
      doc.setFontSize(22);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(30, 41, 59);
      doc.text('SALES ORDER', 14, 20);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      doc.text(`Order Ref: ${order.orderNumber}`, 14, 26);
      doc.text(`Date: ${order.orderDate}`, 14, 31);
      if (order.orderDueDate) {
        doc.text(`Due Date: ${order.orderDueDate}`, 14, 36);
      }

      // Company Info (Right aligned)
      doc.setFontSize(11);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(30, 41, 59);
      doc.text(companyProfile.name, 196, 20, { align: 'right' });

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      const compDetails = [
        companyProfile.address,
        `Tax ID: ${companyProfile.taxId}`,
        companyProfile.email,
        companyProfile.phone
      ].filter(Boolean);

      let compY = 25;
      compDetails.forEach(line => {
        doc.text(line, 196, compY, { align: 'right' });
        compY += 4.5;
      });

      // Divider line
      doc.setDrawColor(226, 232, 240);
      doc.line(14, 48, 196, 48);

      // --- Bill To Section ---
      doc.setFontSize(10);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(79, 70, 229);
      doc.text('CUSTOMER / BILL TO:', 14, 55);

      doc.setFontSize(10);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(30, 41, 59);
      doc.text(order.customer.name || 'N/A', 14, 61);

      doc.setFontSize(9);
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      let custY = 66;
      if (order.customer.taxId) { doc.text(`Tax ID: ${order.customer.taxId}`, 14, custY); custY += 4.5; }
      if (order.customer.email) { doc.text(`Email: ${order.customer.email}`, 14, custY); custY += 4.5; }
      if (order.customer.address) {
        const addressLines = doc.splitTextToSize(order.customer.address, 90);
        doc.text(addressLines, 14, custY);
      }

      // --- Line Items Table ---
      const tableRows = order.items.map(item => [
        item.code || '—',
        item.description,
        item.quantity.toString(),
        `$${item.unitPrice.toFixed(2)}`,
        `$${item.total.toFixed(2)}`
      ]);

      doc.autoTable({
        startY: 85,
        head: [['Item Code', 'Description', 'Qty', 'Unit Price', 'Total Amount']],
        body: tableRows,
        theme: 'striped',
        headStyles: {
          fillColor: brandColor,
          textColor: [255, 255, 255],
          fontStyle: 'bold',
          fontSize: 9
        },
        styles: {
          fontSize: 9,
          cellPadding: 3.5,
          textColor: [30, 41, 59]
        },
        columnStyles: {
          0: { cellWidth: 30 },
          1: { cellWidth: 'auto' },
          2: { cellWidth: 20, halign: 'right' },
          3: { cellWidth: 28, halign: 'right' },
          4: { cellWidth: 28, halign: 'right' }
        }
      });

      // --- Summary / Totals Table ---
      const finalY = doc.lastAutoTable.finalY + 8;

      // Terms & Notes Box
      doc.setFontSize(9);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(30, 41, 59);
      doc.text('Terms & Notes:', 14, finalY);

      doc.setFont('helvetica', 'normal');
      doc.setTextColor(100, 116, 139);
      const noteLines = doc.splitTextToSize(order.notes || 'Thank you for your business. Payment is due as agreed.', 100);
      doc.text(noteLines, 14, finalY + 5);

      // Numeric Totals
      const summaryX = 130;
      let summaryY = finalY;

      doc.setFontSize(9);
      doc.text('Subtotal:', summaryX, summaryY);
      doc.text(`$${order.subtotal.toFixed(2)}`, 196, summaryY, { align: 'right' });
      summaryY += 6;

      if (order.discountRate > 0) {
        doc.text(`Discount (${order.discountRate}%):`, summaryX, summaryY);
        doc.text(`-$${order.discountAmount.toFixed(2)}`, 196, summaryY, { align: 'right' });
        summaryY += 6;
      }

      if (order.taxRate > 0) {
        doc.text(`Tax (${order.taxRate}%):`, summaryX, summaryY);
        doc.text(`$${order.taxAmount.toFixed(2)}`, 196, summaryY, { align: 'right' });
        summaryY += 6;
      }

      // Grand Total Line
      doc.setDrawColor(200, 200, 200);
      doc.line(summaryX, summaryY, 196, summaryY);
      summaryY += 6;

      doc.setFontSize(11);
      doc.setFont('helvetica', 'bold');
      doc.setTextColor(30, 41, 59);
      doc.text('Grand Total:', summaryX, summaryY);
      doc.setTextColor(79, 70, 229);
      doc.text(`$${order.grandTotal.toFixed(2)}`, 196, summaryY, { align: 'right' });

      // Authorized Signature Block
      const signY = summaryY + 28;
      if (signY < 270) {
        doc.setDrawColor(180, 180, 180);
        doc.line(14, signY, 70, signY);
        doc.setFontSize(8);
        doc.setTextColor(100, 116, 139);
        doc.text('Authorized Signature / Date', 14, signY + 4);
      }

      // Save PDF to browser
      doc.save(`SalesOrder_${order.orderNumber}.pdf`);
    }

    // --- Initial Bootstrapping ---
    window.addEventListener('DOMContentLoaded', () => {
      populateCustomerSelect();
      loadCompanyProfile();
      resetOrderForm();
    });
  </script>
</body>
